#!/usr/bin/env bash
# Secret-Check vor jedem Commit (Repo ist öffentlich!)
# Aktivieren: git config core.hooksPath hooks
set -euo pipefail

patterns='sk-(proj-)?[A-Za-z0-9_-]{20,}|ghp_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{30,}|AKIA[0-9A-Z]{16}|xox[baprs]-[A-Za-z0-9-]{10,}|-----BEGIN [A-Z ]*PRIVATE KEY-----|AIza[0-9A-Za-z_-]{35}'
forbidden='(^|/)(\.claude/|settings\.local\.json$|.*\.keyring$|id_(rsa|ed25519|ecdsa)$|\.env$|secrets\.zsh$)'

fail=0
while IFS= read -r -d '' f; do
    if [[ "$f" =~ $forbidden ]]; then
        echo "✗ verbotene Datei: $f"; fail=1; continue
    fi
    if git show ":$f" 2>/dev/null | grep -qEI "$patterns"; then
        echo "✗ mögliches Secret in: $f"
        git show ":$f" | grep -nEI "$patterns" | sed -E 's/(.{12}).*/\1…  (gekürzt)/' | head -3
        fail=1
    fi
done < <(git diff --cached --name-only -z --diff-filter=ACMR)

if (( fail )); then
    echo; echo "Commit abgebrochen. Prüfen, entfernen, erneut stagen. (Notfalls: git commit --no-verify)"
    exit 1
fi

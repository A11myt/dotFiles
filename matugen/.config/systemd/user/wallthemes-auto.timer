[Unit]
Description=Hell/Dunkel nach Sonnenstand prüfen (schaltet nur bei Auf-/Untergang)

[Timer]
# frühestens 1 min nach dem Login (Hyprland und Quickshell sind dann bereit),
# danach alle 5 min; verpasste Läufe NICHT beim Start nachholen (kein Persistent)
OnStartupSec=1min
OnCalendar=*:0/5
AccuracySec=30s

[Install]
WantedBy=timers.target

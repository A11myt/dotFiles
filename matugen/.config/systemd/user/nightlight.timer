[Unit]
Description=Nachtlicht alle 5 Minuten nachführen (sanfter Übergang)

[Timer]
# frühestens 1 min nach dem Login (Hyprland und Quickshell sind dann bereit),
# danach alle 5 min; verpasste Läufe NICHT beim Start nachholen (kein Persistent)
OnStartupSec=1min
OnCalendar=*:0/5
AccuracySec=30s

[Install]
WantedBy=timers.target

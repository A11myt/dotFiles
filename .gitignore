# ── Lokal / Tools ────────────────────────────────────────────────
.claude/
node_modules/
@girs/
*.bak
*.log
__pycache__/

# ── Von Matugen generiert (ändert sich bei jedem Wallpaper) ──────
alacritty/.config/alacritty/colors/matugen.toml
hypr/.config/hypr/themes/matugen.conf
hypr/.config/hypr/themes/matugen.lua
rofi/.config/rofi/colors.rasi
swaync/.config/swaync/colors/
ags/.config/ags/colors.scss
nvim/.config/nvim/lua/config/matugen_colors.lua
tmux/.config/tmux/colors.conf
gtk/.config/gtk-3.0/colors.css
gtk/.config/gtk-4.0/colors.css
qt/.config/qt5ct/colors/
qt/.config/qt6ct/colors/

# ── Persönlich / maschinenspezifisch ─────────────────────────────
gtk/.config/gtk-3.0/bookmarks

# ── Von fontgen generiert ────────────────────────────────────────
alacritty/.config/alacritty/fonts.toml
ags/.config/ags/fonts.scss
rofi/.config/rofi/fonts.rasi
swaync/.config/swaync/fonts.css
hypr/.config/hypr/themes/fonts.conf

# ── Von Hyprland autogeneriert ───────────────────────────────────
hypr/.config/hypr/hyprland.conf

# ── Niemals committen ────────────────────────────────────────────
*.keyring
id_*
*.pem
.env
secrets.zsh

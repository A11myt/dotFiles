/* Wallpaper-Picker (matugen/wallpaper-picker.sh) — Grid mit Vorschaubildern */
@import "config.rasi"

window {
    width:            1060;
    y-offset:         0;
}

listview {
    columns:          4;
    lines:            3;
    flow:             horizontal;
    fixed-columns:    true;
    spacing:          10;
    scrollbar:        false;
}

element {
    orientation:      vertical;
    padding:          10;
    spacing:          8;
    border-radius:    18;
}

element-icon {
    size:             220px;
    horizontal-align: 0.5;
}

element-text {
    horizontal-align: 0.5;
}

element-text selected {
    font:             @font-text;
    letter-spacing:   0;
}

#!/usr/bin/env python3
"""wallthemes – Matugen-Theming mit Cache pro Wallpaper und parallelen Hooks.

  wallthemes <bild>            Theme anwenden (aus dem Cache, sonst einmal rendern)
  wallthemes <bild> --refresh  Cache für dieses Bild neu rendern
  wallthemes [<bild>] --color <#hex> [--scheme S] [--mode dark|light] [--contrast C]
                    [--override rolle=#hex …]
                               Theme mit fester Ausgangsfarbe (z. B. aus Theme Studio) anwenden;
                               Überschreibungen einzelner Farben gelten für dieses Bild
                               (ohne Bild: aktuelles Wallpaper)
  wallthemes build             Cache für alle Bilder in ~/Pictures/wallpapers vorrendern
  wallthemes clean             Caches entfernen, deren Bild nicht mehr existiert
  wallthemes list              Gecachte Wallpaper anzeigen
  wallthemes state             Einstellungen, aktuelles Bild und seine 4 Ausgangsfarben als JSON
  wallthemes set <key> <wert>  [matugen]-Einstellung ändern (scheme, mode, source, contrast)
                               und das aktuelle Wallpaper neu einfärben
  wallthemes pick <0-3|auto>   Ausgangsfarbe für das aktuelle Wallpaper festlegen
  wallthemes auto [on|off]     Hell/Dunkel nach Sonnenauf-/-untergang ([auto] in wallthemes.toml);
                               ohne Argument: prüfen und bei einem Übergang umschalten (Timer)

Cache: ~/.local/share/wallthemes/<bildname>/
  files/<absoluter Zielpfad>   alle gerenderten Configs (wie matugen --prefix sie ablegt)
  colors.json                  Farbpalette
  stamp                        Hash aus Bild, config.toml, Templates und matugen-Version

Matugen selbst würde die Hooks nacheinander ausführen (~25 s, davon 0,6 s Farbberechnung).
Hier rendert Matugen ohne Hooks, die Dateien werden kopiert und die post_hooks aus
config.toml laufen parallel. config.toml bleibt die einzige Quelle für Templates und Hooks.

Hooks für Apps, die gerade nicht laufen, werden still im Hintergrund nachgeholt
(Regeln in ~/.config/matugen/wallthemes.toml).
"""
import fcntl
import math
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
import tomllib
from datetime import date, datetime, timedelta, timezone
from pathlib import Path

HOME = Path.home()
CONFIG = HOME / ".config/matugen/config.toml"
RULES = HOME / ".config/matugen/wallthemes.toml"
DEFER_TOKEN = HOME / ".cache/matugen/wallthemes-deferred.token"
DEFER_LOCK = HOME / ".cache/matugen/wallthemes-deferred.lock"
CACHE = HOME / ".local/share/wallthemes"
WALL_DIR = HOME / "Pictures/wallpapers"
LOG = HOME / ".logs/wallthemes" / f"{datetime.now():%Y-%m-%d}.log"
CURRENT = HOME / ".cache/wallpaper-picker/current"
SCHEMES = ["tonal-spot", "vibrant", "expressive", "fidelity", "content", "fruit-salad", "rainbow", "neutral", "monochrome"]
SOURCES = ["dominant", "value", "saturation", "lightness", "darkness", "less-saturation"]
IMAGE_EXT = {".jpg", ".jpeg", ".png", ".webp", ".gif"}
HOOK_TIMEOUT = 60


def rules() -> dict:
    return tomllib.loads(RULES.read_text()) if RULES.exists() else {}


def mode() -> str:
    return "light" if rules().get("matugen", {}).get("mode") == "light" else "dark"


def matugen_args(image: Path) -> list[str]:
    """Schema, Modus, Kontrast und Ausgangsfarbe aus wallthemes.toml.

    [matugen] gilt für alle Bilder, [pick] legt pro Bild eine der 4 Ausgangsfarben fest."""
    r = rules()
    m = r.get("matugen", {})
    args = ["-t", f"scheme-{m.get('scheme', 'tonal-spot')}", "-m", mode()]
    if float(m.get("contrast", 0)):
        args += ["--contrast", str(float(m["contrast"]))]
    pick = r.get("pick", {}).get(image.name)
    source = m.get("source", "dominant")
    if isinstance(pick, str):    # feste Farbe → Quelle ist „color hex“, siehe source_args()
        pass
    elif isinstance(pick, int):
        args += ["--source-color-index", str(pick)]
    elif source == "dominant":   # häufigste Farbe im Bild
        args += ["--source-color-index", "0"]
    else:                        # --prefer value/saturation/…
        args += ["--prefer", source]
    return args


HEX = re.compile(r"#[0-9a-fA-F]{6}")


def source_args(image: Path) -> list[str]:
    """matugen-Quelle: das Bild – oder eine feste Farbe aus [pick] (z. B. aus Theme Studio)."""
    pick = rules().get("pick", {}).get(image.name)
    if isinstance(pick, str) and HEX.fullmatch(pick):
        return ["color", "hex", pick]
    return ["image", str(image)]


def overrides(image: Path) -> dict[str, str]:
    """Überschriebene Farben für dieses Bild ([override] in wallthemes.toml, JSON-Text je Bild)."""
    raw = rules().get("override", {}).get(image.name)
    try:
        d = json.loads(raw) if isinstance(raw, str) else {}
    except ValueError:
        return {}
    return {k: v for k, v in d.items() if re.fullmatch(r"[a-z_]+", k) and isinstance(v, str) and HEX.fullmatch(v)}


def log(level: str, msg: str) -> None:
    LOG.parent.mkdir(parents=True, exist_ok=True)
    with LOG.open("a") as f:
        f.write(f"{datetime.now():%Y-%m-%d %H:%M:%S} [{level:<5}] {msg}\n")
    if level != "INFO" or sys.stdout.isatty():
        print(f"wallthemes: {msg}", file=sys.stderr if level != "INFO" else sys.stdout)


def expand(p: str) -> Path:
    return Path(os.path.expanduser(p))


def load_config() -> dict:
    return tomllib.loads(CONFIG.read_text())


def stamp_for(image: Path, cfg: dict) -> str:
    h = hashlib.sha256()
    st = image.stat()
    h.update(f"{image.resolve()}|{st.st_size}|{st.st_mtime_ns}".encode())
    h.update(CONFIG.read_bytes())
    for t in cfg.get("templates", {}).values():
        src = expand(t["input_path"])
        h.update(src.read_bytes() if src.exists() else b"missing")
    version = subprocess.run(["matugen", "--version"], capture_output=True, text=True).stdout
    h.update(version.encode())
    h.update(" ".join(matugen_args(image)).encode())
    h.update(" ".join(source_args(image)).encode())
    h.update(json.dumps(overrides(image), sort_keys=True).encode())
    return h.hexdigest()


def toml_value(v) -> str:
    # JSON-Strings/Zahlen/Bools sind gültiges TOML
    return json.dumps(v)


def render(image: Path, cfg: dict, target: Path, stamp: str) -> None:
    """Rendert alle Templates ohne Hooks/Wallpaper nach target/files."""
    tmp = Path(tempfile.mkdtemp(prefix="wallthemes-", dir=CACHE))
    try:
        lines = ["[config]", ""]
        for name, t in cfg.get("templates", {}).items():
            lines.append(f"[templates.{toml_value(name)}]")
            lines += [f"{k} = {toml_value(v)}" for k, v in t.items() if k != "post_hook"]
            lines.append("")
        cfg_file = tmp / "config.toml"
        cfg_file.write_text("\n".join(lines))

        files = tmp / "files"
        source = source_args(image)
        over = overrides(image)
        if over:
            # 1) volle Palette berechnen (ohne Dateien), 2) Farben ersetzen, 3) Vorlagen damit füllen
            r = subprocess.run(["matugen", *source, *matugen_args(image), "-c", str(cfg_file),
                                "--prefix", str(tmp / "dry"), "--json", "hex"], capture_output=True, text=True)
            if r.returncode != 0:
                raise RuntimeError(f"matugen fehlgeschlagen: {r.stderr.strip()[-500:]}")
            pal = json.loads(r.stdout[r.stdout.find("{"):])
            for role, hexv in over.items():
                if role in pal.get("colors", {}):
                    for variant in ("default", mode()):
                        pal["colors"][role][variant] = {"color": hexv.lower()}
            (tmp / "palette.json").write_text(json.dumps(pal))
            shutil.rmtree(tmp / "dry", ignore_errors=True)
            source = ["json", str(tmp / "palette.json")]
        r = subprocess.run(
            ["matugen", *source, *matugen_args(image),
             "-c", str(cfg_file), "--prefix", str(files), "--json", "hex"],
            capture_output=True, text=True,
        )
        if r.returncode != 0:
            raise RuntimeError(f"matugen fehlgeschlagen: {r.stderr.strip()[-500:]}")
        # stdout = JSON-Palette, davor ggf. Statuszeilen
        out = r.stdout
        (tmp / "colors.json").write_text(out[out.find("{"):] if "{" in out else out)
        (tmp / "image").write_text(str(image.resolve()) + "\n")
        (tmp / "stamp").write_text(stamp)
        cfg_file.unlink()

        if target.exists():
            shutil.rmtree(target)
        tmp.rename(target)  # atomar: halbfertige Caches gibt es nie
    finally:
        if tmp.exists():
            shutil.rmtree(tmp, ignore_errors=True)


def ensure_cache(image: Path, cfg: dict, refresh: bool = False) -> tuple[Path, bool]:
    CACHE.mkdir(parents=True, exist_ok=True)
    target = CACHE / image.name
    stamp = stamp_for(image, cfg)
    stamp_file = target / "stamp"
    if not refresh and stamp_file.exists() and stamp_file.read_text() == stamp:
        return target, True
    render(image, cfg, target, stamp)
    return target, False


def install(target: Path, cfg: dict) -> int:
    """Kopiert die gecachten Dateien an ihre Zielorte (atomar per rename)."""
    missing = 0
    for name, t in cfg.get("templates", {}).items():
        dest = expand(t["output_path"])
        src = target / "files" / str(dest).lstrip("/")
        if not src.exists():
            log("WARN", f"{name}: nicht im Cache ({src})")
            missing += 1
            continue
        dest.parent.mkdir(parents=True, exist_ok=True)
        tmp = dest.with_name(f".{dest.name}.wallthemes")
        shutil.copyfile(src, tmp)
        os.replace(tmp, dest)
    return missing


def running_processes() -> set[str]:
    names = set()
    for d in Path("/proc").iterdir():
        if d.name.isdigit():
            try:
                names.add((d / "comm").read_text().strip())
            except OSError:
                pass
    return names


def split_hooks(cfg: dict) -> tuple[list[str], list[str], int]:
    """Teilt Templates mit Hook in (sofort, später) nach wallthemes.toml."""
    rules = tomllib.loads(RULES.read_text()) if RULES.exists() else {}
    defer = rules.get("defer", {})
    procs = running_processes()
    now, later = [], []
    for name, t in cfg.get("templates", {}).items():
        if not t.get("post_hook"):
            continue
        rule = defer.get(name)
        if rule == "always" or (isinstance(rule, list) and not procs.intersection(rule)):
            later.append(name)
        else:
            now.append(name)
    return now, later, int(rules.get("delay", 20))


def run_hooks(cfg: dict, image: Path, names: list[str]) -> int:
    templates = cfg.get("templates", {})
    procs = []
    LOG.parent.mkdir(parents=True, exist_ok=True)
    with LOG.open("a") as logf:
        for name in names:
            hook = templates[name]["post_hook"]
            hook = hook.replace("{{mode}}", mode()).replace("{{ mode }}", mode())
            hook = hook.replace("{{image}}", str(image)).replace("{{ image }}", str(image))
            if "{{" in hook:
                log("WARN", f"{name}: unbekannter Platzhalter im Hook: {hook}")
            p = subprocess.Popen(["bash", "-c", hook], cwd=HOME, stdout=logf,
                                 stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL)
            procs.append((name, p, time.monotonic()))

    failed = 0
    for name, p, start in procs:
        try:
            rc = p.wait(timeout=max(1, HOOK_TIMEOUT - (time.monotonic() - start)))
        except subprocess.TimeoutExpired:
            p.kill()
            rc = "timeout"
        if rc != 0:
            log("WARN", f"hook {name}: exit {rc}")
            failed += 1
    return failed


def claim_token() -> str:
    """Markiert diesen Wechsel als den neuesten; ältere Hintergrund-Läufe brechen dann ab."""
    token = str(time.time_ns())
    DEFER_TOKEN.parent.mkdir(parents=True, exist_ok=True)
    DEFER_TOKEN.write_text(token)
    return token


def schedule_deferred(image: Path, names: list[str], delay: int, token: str) -> None:
    """Startet einen abgekoppelten Lauf für die übrigen Hooks."""
    if not names:
        return
    subprocess.Popen([sys.executable, __file__, "--deferred", token, str(delay), str(image), *names],
                     start_new_session=True, stdin=subprocess.DEVNULL,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def run_deferred(token: str, delay: int, image: Path, names: list[str]) -> int:
    # nur rechnen, wenn die CPU sonst nichts zu tun hat → bremst den sichtbaren Wechsel nicht
    # (gilt auch für alle Hooks, die von hier gestartet werden)
    os.sched_setscheduler(0, os.SCHED_IDLE, os.sched_param(0))
    subprocess.run(["ionice", "-c", "3", "-p", str(os.getpid())], check=False)
    if delay:
        time.sleep(delay)
    # ein abgebrochener Vorgänger beendet noch seinen laufenden Hook → darauf warten,
    # sonst laufen z. B. zwei AdwSteamGtk-Instanzen gleichzeitig und kollidieren über D-Bus
    lock = DEFER_LOCK.open("w")
    fcntl.flock(lock, fcntl.LOCK_EX)
    cfg = load_config()
    names = [n for n in names if cfg.get("templates", {}).get(n, {}).get("post_hook")]
    t0 = time.monotonic()
    failed = 0
    # nacheinander statt parallel: hält die Last klein; vor jedem Hook prüfen,
    # ob inzwischen ein neueres Wallpaper gewählt wurde – dann übernimmt dessen Lauf
    for name in names:
        if not DEFER_TOKEN.exists() or DEFER_TOKEN.read_text() != token:
            log("INFO", f"{image.name}: Hintergrund-Lauf abgebrochen (neueres Wallpaper)")
            return 0
        failed += run_hooks(cfg, image, [name])
    log("INFO", f"{image.name}: Hintergrund-Hooks {', '.join(names)} "
                f"({time.monotonic() - t0:.1f} s, {failed} Fehler)")
    return 1 if failed else 0


def set_wallpaper(cfg: dict, image: Path) -> subprocess.Popen | None:
    wp = cfg.get("config", {}).get("wallpaper", {})
    if not wp.get("set") or not wp.get("command"):
        return None
    cmd = wp["command"].replace("{{ image }}", str(image)).replace("{{image}}", str(image))
    return subprocess.Popen(["bash", "-c", cmd], cwd=HOME, stdin=subprocess.DEVNULL,
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def apply(image: Path, refresh: bool, set_wall: bool = True) -> int:
    t0 = time.monotonic()
    token = claim_token()
    cfg = load_config()
    # sofort, die Übergangsanimation läuft parallel (nicht beim bloßen Umfärben)
    wp = set_wallpaper(cfg, image) if set_wall else None
    try:
        target, hit = ensure_cache(image, cfg, refresh)
    except RuntimeError as e:
        log("ERROR", f"{image.name}: {e}")
        return 1
    t_cache = time.monotonic() - t0
    missing = install(target, cfg)
    now, later, delay = split_hooks(cfg)
    failed = run_hooks(cfg, image, now)
    schedule_deferred(image, later, delay, token)  # direkt danach, still und mit niedriger Priorität
    if wp:
        wp.wait(timeout=HOOK_TIMEOUT)
    log("INFO", f"{image.name}: {'Cache' if hit else 'neu gerendert'} ({t_cache:.1f} s), "
                f"gesamt {time.monotonic() - t0:.1f} s, {failed} Hook-Fehler, {missing} fehlend, "
                f"später: {', '.join(later) or '–'}")
    return 1 if failed or missing else 0


def wallpapers() -> list[Path]:
    return sorted(p for p in WALL_DIR.iterdir() if p.suffix.lower() in IMAGE_EXT)


def build() -> int:
    cfg = load_config()
    errors = 0
    for img in wallpapers():
        try:
            _, hit = ensure_cache(img, cfg)
            print(f"{'✓ aktuell ' if hit else '+ gerendert'}  {img.name}")
        except RuntimeError as e:
            print(f"✗ Fehler    {img.name}: {e}")
            errors += 1
    return 1 if errors else 0


def clean() -> int:
    if not CACHE.exists():
        return 0
    for d in sorted(CACHE.iterdir()):
        if not d.is_dir():
            continue
        src = (d / "image").read_text().strip() if (d / "image").exists() else ""
        if d.name.startswith("wallthemes-") or not src or not Path(src).exists():
            shutil.rmtree(d)
            print(f"entfernt  {d.name}")
    return 0


def list_cache() -> int:
    cfg = load_config()
    for img in wallpapers():
        d = CACHE / img.name
        ok = (d / "stamp").exists() and (d / "stamp").read_text() == stamp_for(img, cfg)
        print(f"{'✓' if ok else '·'}  {img.name}")
    return 0


# ── Hell/Dunkel nach Sonnenstand ─────────────────────────────────────────────
AUTO_STATE = HOME / ".local/state/wallthemes/auto-phase"


def sun_times(day: date, lat: float, lon: float) -> tuple[datetime, datetime]:
    """Sonnenauf- und -untergang (lokale Zeit) nach der NOAA-Näherung, auf ~1–2 min genau."""
    n = day.timetuple().tm_yday
    g = 2 * math.pi / 365 * (n - 1)
    eqt = 229.18 * (0.000075 + 0.001868 * math.cos(g) - 0.032077 * math.sin(g)
                    - 0.014615 * math.cos(2 * g) - 0.040849 * math.sin(2 * g))
    decl = (0.006918 - 0.399912 * math.cos(g) + 0.070257 * math.sin(g) - 0.006758 * math.cos(2 * g)
            + 0.000907 * math.sin(2 * g) - 0.002697 * math.cos(3 * g) + 0.00148 * math.sin(3 * g))
    phi = math.radians(lat)
    cos_ha = math.cos(math.radians(90.833)) / (math.cos(phi) * math.cos(decl)) - math.tan(phi) * math.tan(decl)
    ha = math.degrees(math.acos(max(-1.0, min(1.0, cos_ha))))
    midnight = datetime(day.year, day.month, day.day, tzinfo=timezone.utc)
    rise = midnight + timedelta(minutes=720 - 4 * (lon + ha) - eqt)
    set_ = midnight + timedelta(minutes=720 - 4 * (lon - ha) - eqt)
    return rise.astimezone(), set_.astimezone()


def auto_cfg() -> dict:
    a = rules().get("auto", {})
    return {"enabled": bool(a.get("enabled", False)), "lat": float(a.get("lat", 49.66)), "lon": float(a.get("lon", 9.0))}


def sun_phase(now: datetime | None = None) -> tuple[str, datetime, datetime]:
    """(\"light\"|\"dark\", Aufgang, Untergang) für heute."""
    a = auto_cfg()
    now = now or datetime.now().astimezone()
    rise, set_ = sun_times(now.date(), a["lat"], a["lon"])
    return ("light" if rise <= now < set_ else "dark"), rise, set_


def auto(arg: str | None) -> int:
    if arg in ("on", "off"):
        edit_rules("auto", "enabled", arg == "on")
        if arg == "off":
            return 0
        AUTO_STATE.unlink(missing_ok=True)   # sofort passend schalten
    a = auto_cfg()
    if not a["enabled"]:
        return 0
    phase, rise, set_ = sun_phase()
    # nur bei einem Übergang schalten → ein Wechsel von Hand gilt bis zum nächsten Auf-/Untergang
    last = AUTO_STATE.read_text().strip() if AUTO_STATE.exists() else ""
    AUTO_STATE.parent.mkdir(parents=True, exist_ok=True)
    AUTO_STATE.write_text(phase)
    if last == phase or mode() == phase:
        return 0
    log("INFO", f"auto: {phase} (Aufgang {rise:%H:%M}, Untergang {set_:%H:%M})")
    edit_rules("matugen", "mode", phase)
    return recolor()


# ── Einstellungen (für die Quickshell-Einstellungen und die Kommandozeile) ───
def current_image() -> Path | None:
    p = CURRENT.resolve() if CURRENT.exists() else None
    return p if p and p.is_file() else None


def source_colors(image: Path) -> list[str]:
    r = subprocess.run(["matugen", "image", str(image), "--show-source-colors"], capture_output=True, text=True)
    return [l.strip() for l in r.stdout.splitlines() if l.strip().startswith("#")][:4]


def comment_start(line: str) -> int | None:
    """Position eines TOML-Kommentars (#) außerhalb von Anführungszeichen – "#db79a9" ist keiner."""
    quote = None
    for i, ch in enumerate(line):
        if quote:
            if ch == "\\" and quote == '"':
                continue
            if ch == quote and line[i - 1] != "\\":
                quote = None
        elif ch in "\"'":
            quote = ch
        elif ch == "#":
            return i
    return None


def edit_rules(section: str, key: str, value) -> None:
    """Setzt key = value in [section] von wallthemes.toml, Kommentare bleiben erhalten.
    value None entfernt den Eintrag."""
    lines = RULES.read_text().splitlines() if RULES.exists() else []
    head = f"[{section}]"
    line = None if value is None else f"{json.dumps(key) if not key.isidentifier() else key} = {toml_value(value)}"
    try:
        start = next(i for i, l in enumerate(lines) if l.strip() == head)
    except StopIteration:
        if line:
            lines += ["", head, line]
    else:
        end = next((i for i in range(start + 1, len(lines)) if lines[i].lstrip().startswith("[")), len(lines))
        keys = (key, json.dumps(key))
        idx = next((i for i in range(start + 1, end) if lines[i].split("=")[0].strip() in keys), None)
        if idx is not None:
            cpos = comment_start(lines[idx])
            comment = lines[idx][cpos:] if cpos is not None else ""
            if line is None:
                del lines[idx]
            else:
                lines[idx] = f"{line}   {comment}".rstrip() if comment else line
        elif line:
            while end > start + 1 and not lines[end - 1].strip():
                end -= 1
            lines.insert(end, line)
    tmp = RULES.with_suffix(".tmp")
    tmp.write_text("\n".join(lines) + "\n")
    os.replace(tmp, RULES.resolve() if RULES.is_symlink() else RULES)
    tmp.unlink(missing_ok=True)


def state() -> int:
    img = current_image()
    m = rules().get("matugen", {})
    print(json.dumps({
        "image": str(img or ""),
        "scheme": m.get("scheme", "tonal-spot"), "schemes": SCHEMES,
        "mode": mode(),
        "source": m.get("source", "dominant"), "sources": SOURCES,
        "contrast": float(m.get("contrast", 0)),
        "auto": auto_cfg()["enabled"],
        "sunrise": f"{sun_phase()[1]:%H:%M}", "sunset": f"{sun_phase()[2]:%H:%M}",
        "pick": rules().get("pick", {}).get(img.name) if img else None,
        "colors": source_colors(img) if img else [],
    }))
    return 0


def recolor() -> int:
    img = current_image()
    if not img:
        log("ERROR", "kein aktuelles Wallpaper")
        return 1
    return apply(img, refresh=False, set_wall=False)


def set_option(key: str, value: str) -> int:
    allowed = {"scheme": SCHEMES, "mode": ["dark", "light"], "source": SOURCES}
    if key == "contrast":
        val = max(-1.0, min(1.0, float(value)))
    elif key in allowed and value in allowed[key]:
        val = value
    else:
        print(f"wallthemes: ungültig: {key} = {value}", file=sys.stderr)
        return 2
    edit_rules("matugen", key, val)
    return recolor()


def pick(value: str) -> int:
    img = current_image()
    if not img:
        return 1
    edit_rules("pick", img.name, None if value == "auto" else max(0, min(3, int(value))))
    edit_rules("override", img.name, None)      # Studio-Überschreibungen gehören zur Studio-Farbe
    return recolor()


def main(argv: list[str]) -> int:
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    cmd = argv[0]
    if cmd == "--deferred":
        return run_deferred(argv[1], int(argv[2]), Path(argv[3]), argv[4:])
    if cmd == "build":
        return build()
    if cmd == "clean":
        return clean()
    if cmd == "list":
        return list_cache()
    if cmd == "state":
        return state()
    if cmd == "set" and len(argv) == 3:
        return set_option(argv[1], argv[2])
    if cmd == "pick" and len(argv) == 2:
        return pick(argv[1])
    if cmd == "recolor":
        return recolor()
    if cmd == "auto":
        return auto(argv[1] if len(argv) > 1 else None)
    image = current_image() if cmd.startswith("--") else Path(cmd).expanduser()
    if not image or not image.is_file():
        log("ERROR", f"Bild nicht gefunden: {image or 'kein aktuelles Wallpaper'}")
        return 1
    image = image.resolve()
    if "--color" in argv:
        rc = studio_options(image, argv)
        if rc:
            return rc
    return apply(image, refresh="--refresh" in argv)


def studio_options(image: Path, argv: list[str]) -> int:
    """--color/--scheme/--mode/--contrast/--override übernehmen (dauerhaft, wie wallthemes set/pick)."""
    opts: dict[str, str] = {}
    over: dict[str, str] = {}
    it = iter(argv)
    for a in it:
        if a in ("--color", "--scheme", "--mode", "--contrast"):
            opts[a[2:]] = next(it, "")
        elif a == "--override":
            role, _, val = next(it, "").partition("=")
            if not (re.fullmatch(r"[a-z_]+", role) and HEX.fullmatch(val)):
                log("ERROR", f"--override erwartet rolle=#rrggbb, nicht {role}={val}")
                return 2
            over[role] = val.lower()
    if not HEX.fullmatch(opts.get("color", "")):
        log("ERROR", f"--color erwartet #rrggbb, nicht {opts.get('color')}")
        return 2
    if "scheme" in opts and opts["scheme"] not in SCHEMES or "mode" in opts and opts["mode"] not in ("dark", "light"):
        log("ERROR", f"ungültig: scheme={opts.get('scheme')} mode={opts.get('mode')}")
        return 2
    for key in ("scheme", "mode"):
        if key in opts:
            edit_rules("matugen", key, opts[key])
    if "contrast" in opts:
        edit_rules("matugen", "contrast", max(-1.0, min(1.0, float(opts["contrast"]))))
    edit_rules("pick", image.name, opts["color"].lower())
    edit_rules("override", image.name, json.dumps(over, sort_keys=True) if over else None)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

#!/usr/bin/env python3
"""fontgen – Schriften systemweit aus einer Quelle setzen (analog zu Matugen für Farben).

  fontgen               aktives Profil (neu) anwenden
  fontgen use <profil>  Profil aktivieren und anwenden
  fontgen list          Profile anzeigen, prüfen ob die Schriften installiert sind
  fontgen size <ui> <mono>  Schriftgrößen (pt) des aktiven Profils ändern und anwenden
  fontgen define <name> <ui> <mono> <accent> <ui_size> <mono_size>
                        Profil anlegen/ersetzen, aktivieren und anwenden (z. B. aus Theme Studio)
  fontgen state         Profile, aktives Profil und Größen als JSON (für die Einstellungen)

Konfiguration: ~/.config/fontgen/config.toml
  profile = "<aktives Profil>"
  [profiles.<name>]   ui, mono, accent (Familiennamen), ui_size, mono_size (pt)
  [templates.<name>]  input_path, output_path, post_hook – wie bei Matugen
  [ini.<name>]        path, section, key, value – einzelnen Eintrag in einer INI setzen
  [hooks]             commands = [...] – laufen nach allem anderen

Platzhalter in Templates, INI-Werten und Hooks: {{fonts.ui}}, {{fonts.mono}}, {{fonts.accent}},
{{fonts.ui_size}}, {{fonts.mono_size}}, {{fonts.ui_px}}, {{fonts.mono_px}}
"""
import json
import os
import re
import subprocess
import sys
import tomllib
from datetime import datetime
from pathlib import Path

HOME = Path.home()
CONFIG = HOME / ".config/fontgen/config.toml"
LOG = HOME / ".logs/fontgen" / f"{datetime.now():%Y-%m-%d}.log"


def log(msg: str) -> None:
    LOG.parent.mkdir(parents=True, exist_ok=True)
    with LOG.open("a") as f:
        f.write(f"{datetime.now():%Y-%m-%d %H:%M:%S} {msg}\n")


def expand(p: str) -> Path:
    return Path(os.path.expanduser(p))


def installed_families() -> set[str]:
    out = subprocess.run(["fc-list", ":", "family"], capture_output=True, text=True).stdout
    return {f.strip() for line in out.splitlines() for f in line.split(",")}


def values(profile: dict) -> dict[str, str]:
    v = {k: str(profile[k]) for k in ("ui", "mono", "accent", "ui_size", "mono_size")}
    v["ui_px"] = str(round(float(profile["ui_size"]) * 4 / 3))
    v["mono_px"] = str(round(float(profile["mono_size"]) * 4 / 3))
    return v


def render(text: str, v: dict[str, str]) -> str:
    def sub(m: re.Match) -> str:
        key = m.group(1)
        if key not in v:
            raise KeyError(f"unbekannter Platzhalter {{{{fonts.{key}}}}}")
        return v[key]
    return re.sub(r"\{\{\s*fonts\.(\w+)\s*\}\}", sub, text)


def set_ini(path: Path, section: str, key: str, value: str) -> None:
    """Setzt key=value in [section]; legt Abschnitt/Schlüssel an, lässt den Rest unverändert."""
    lines = path.read_text().splitlines() if path.exists() else []
    out, in_sec, done, seen_sec = [], False, False, False
    for line in lines:
        if line.strip().startswith("["):
            if in_sec and not done:
                out.append(f"{key}={value}")
                done = True
            in_sec = line.strip() == f"[{section}]"
            seen_sec = seen_sec or in_sec
        elif in_sec and re.match(rf"^\s*{re.escape(key)}\s*=", line):
            out.append(f"{key}={value}")
            done = True
            continue
        out.append(line)
    if not done:
        if not seen_sec:
            out += ["", f"[{section}]"] if out else [f"[{section}]"]
        out.append(f"{key}={value}")
    path.write_text("\n".join(out) + "\n")


def apply(cfg: dict) -> int:
    name = cfg.get("profile")
    profile = cfg.get("profiles", {}).get(name)
    if not profile:
        print(f"fontgen: Profil '{name}' nicht gefunden", file=sys.stderr)
        return 1
    missing = [profile[r] for r in ("ui", "mono", "accent") if profile[r] not in installed_families()]
    if missing:
        print(f"fontgen: nicht installiert: {', '.join(missing)} – abgebrochen", file=sys.stderr)
        return 1
    v = values(profile)
    errors = 0

    for tname, t in cfg.get("templates", {}).items():
        try:
            dest = expand(t["output_path"])
            dest.parent.mkdir(parents=True, exist_ok=True)
            tmp = dest.with_name(f".{dest.name}.fontgen")
            tmp.write_text(render(expand(t["input_path"]).read_text(), v))
            os.replace(tmp, dest)
        except (OSError, KeyError) as e:
            print(f"fontgen: Template {tname}: {e}", file=sys.stderr)
            errors += 1

    for iname, i in cfg.get("ini", {}).items():
        path = expand(i["path"])
        if not path.exists() and not i.get("create", False):
            continue  # App nicht eingerichtet → überspringen
        try:
            set_ini(path, i["section"], i["key"], render(i["value"], v))
        except (OSError, KeyError) as e:
            print(f"fontgen: INI {iname}: {e}", file=sys.stderr)
            errors += 1

    hooks = [t["post_hook"] for t in cfg.get("templates", {}).values() if t.get("post_hook")]
    hooks += cfg.get("hooks", {}).get("commands", [])
    procs = [subprocess.Popen(["bash", "-c", render(h, v)], cwd=HOME, stdin=subprocess.DEVNULL,
                              stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
             for h in hooks]
    for h, p in zip(hooks, procs):
        _, err = p.communicate(timeout=30)
        if p.returncode != 0:
            print(f"fontgen: Hook fehlgeschlagen ({p.returncode}): {h}\n  {err.strip()[:200]}",
                  file=sys.stderr)
            errors += 1

    msg = f"Profil {name}: ui={v['ui']} {v['ui_size']}, mono={v['mono']} {v['mono_size']}, accent={v['accent']}"
    log(msg + (f" ({errors} Fehler)" if errors else ""))
    print(f"fontgen: {msg}" + (f" – {errors} Fehler" if errors else ""))
    return 1 if errors else 0


def use(name: str) -> int:
    text = CONFIG.read_text()
    if name not in tomllib.loads(text).get("profiles", {}):
        print(f"fontgen: Profil '{name}' gibt es nicht (fontgen list)", file=sys.stderr)
        return 1
    text, n = re.subn(r'(?m)^profile\s*=\s*".*"', f'profile = "{name}"', text, count=1)
    if not n:
        text = f'profile = "{name}"\n' + text
    CONFIG.write_text(text)
    return apply(tomllib.loads(text))


def size(ui: str, mono: str) -> int:
    """Ändert ui_size/mono_size im Abschnitt des aktiven Profils, der Rest der Datei bleibt."""
    ui_v, mono_v = (max(7.0, min(20.0, float(x))) for x in (ui, mono))
    fmt = lambda v: str(int(v)) if v == int(v) else str(v)
    text = CONFIG.read_text()
    name = tomllib.loads(text).get("profile")
    m = re.search(rf'(?ms)^\[profiles\.{re.escape(name)}\]\n(.*?)(?=^\[|\Z)', text)
    if not m:
        print(f"fontgen: Profil '{name}' nicht gefunden", file=sys.stderr)
        return 1
    body = re.sub(r'(?m)^(ui_size\s*=\s*)\S+', rf'\g<1>{fmt(ui_v)}', m.group(1))
    body = re.sub(r'(?m)^(mono_size\s*=\s*)\S+', rf'\g<1>{fmt(mono_v)}', body)
    text = text[:m.start(1)] + body + text[m.end(1):]
    CONFIG.write_text(text)
    return apply(tomllib.loads(text))


def define(name: str, ui: str, mono: str, accent: str, ui_size: str, mono_size: str) -> int:
    """Profil [profiles.<name>] anlegen oder ersetzen (Rest der Datei bleibt), dann aktivieren."""
    if not re.fullmatch(r"[a-z0-9][a-z0-9_-]{0,40}", name):
        print(f"fontgen: ungültiger Profilname '{name}'", file=sys.stderr)
        return 2
    fmt = lambda v: (lambda f: str(int(f)) if f == int(f) else str(f))(max(6.0, min(24.0, float(v))))
    q = lambda v: json.dumps(v, ensure_ascii=False)        # TOML-Strings = JSON-Strings
    block = (f"[profiles.{name}]\nui        = {q(ui)}\nmono      = {q(mono)}\naccent    = {q(accent)}\n"
             f"ui_size   = {fmt(ui_size)}\nmono_size = {fmt(mono_size)}\n\n")
    text = CONFIG.read_text()
    m = re.search(rf'(?ms)^\[profiles\.{re.escape(name)}\]\n.*?(?=^\[|\Z)', text)
    if m:
        text = text[:m.start()] + block + text[m.end():]
    else:   # vor den Templates einfügen, sonst ans Ende
        t = re.search(r'(?m)^# ── Templates|^\[templates\.', text)
        text = text[:t.start()] + block + text[t.start():] if t else text.rstrip() + "\n\n" + block
    tomllib.loads(text)                                     # bleibt gültiges TOML?
    CONFIG.write_text(text)
    return use(name)


def state(cfg: dict) -> int:
    have = installed_families()
    print(json.dumps({
        "profile": cfg.get("profile"),
        "profiles": [{"name": n, "ui": p["ui"], "mono": p["mono"], "accent": p["accent"],
                      "ui_size": p["ui_size"], "mono_size": p["mono_size"],
                      "installed": all(p[r] in have for r in ("ui", "mono", "accent"))}
                     for n, p in cfg.get("profiles", {}).items()],
    }))
    return 0


def list_profiles(cfg: dict) -> int:
    have = installed_families()
    for name, p in cfg.get("profiles", {}).items():
        mark = "●" if name == cfg.get("profile") else " "
        print(f"{mark} {name}")
        for role in ("ui", "mono", "accent"):
            ok = "✓" if p[role] in have else "✗ nicht installiert"
            print(f"    {role:<7} {p[role]}  {ok}")
        print(f"    Größe   ui {p['ui_size']} pt, mono {p['mono_size']} pt")
    return 0


def main(argv: list[str]) -> int:
    if argv and argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    cfg = tomllib.loads(CONFIG.read_text())
    if not argv:
        return apply(cfg)
    if argv[0] == "use" and len(argv) == 2:
        return use(argv[1])
    if argv[0] == "list":
        return list_profiles(cfg)
    if argv[0] == "state":
        return state(cfg)
    if argv[0] == "size" and len(argv) == 3:
        return size(argv[1], argv[2])
    if argv[0] == "define" and len(argv) == 7:
        return define(*argv[1:])
    print(__doc__.strip(), file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
